@model GymManagement.Web.Models.MembershipIndexViewModel
@{ViewData["Title"]="Đăng ký và thanh toán";}
<div class="page-heading"><div><p class="eyebrow">Membership & billing</p><h1>Đăng ký và thanh toán</h1></div><a class="button" asp-action="Create">Đăng ký gói</a></div>
@if(TempData["Success"] is string s){<div class="alert alert-success">@s</div>} @if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>} @if(Model.Notice is not null){<div class="alert alert-danger">@Model.Notice</div>}
<div class="table-card"><table><thead><tr><th>Hội viên</th><th>Gói</th><th>Hiệu lực</th><th>Gói</th><th>Hóa đơn</th><th>Công nợ</th><th></th></tr></thead><tbody>
@foreach(var x in Model.Items){var remaining=(x.Total??0)-(x.Paid??0);<tr><td>@x.MemberCode<br/><strong>@x.MemberName</strong></td><td>@x.PlanName</td><td>@x.StartDate.ToString("dd/MM/yyyy") – @x.EndDate.ToString("dd/MM/yyyy")</td><td><span class="badge">@x.Status</span></td><td>@x.InvoiceCode<br/>@x.InvoiceStatus</td><td>@remaining.ToString("N0") ₫</td><td class="actions">@if(x.InvoiceId is not null&&remaining>0){<a asp-action="Pay" asp-route-invoiceId="@x.InvoiceId">Thanh toán</a>}@if(x.Status is "ACTIVE" or "PENDING" or "SUSPENDED"){<form asp-action="Cancel" asp-route-id="@x.Id" method="post" onsubmit="return confirm('Xác nhận hủy gói?');"><input type="hidden" name="reason" value="Hủy theo yêu cầu hội viên"/><button class="link-button danger" type="submit">Hủy gói</button></form>}</td></tr>}
</tbody></table>@if(Model.Items.Count==0){<p class="empty-state">Chưa có đăng ký gói.</p>}</div>
