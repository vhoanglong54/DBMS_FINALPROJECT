@model GymManagement.Web.Models.MembershipIndexViewModel
@{ ViewData["Title"] = "Đăng ký và thanh toán"; }

<div class="page-heading">
    <div>
        <p class="eyebrow">Membership & billing</p>
        <h1>Đăng ký và thanh toán</h1>
        <p class="muted">Theo dõi thời hạn gói, hóa đơn và công nợ hội viên.</p>
    </div>
    <a class="button" asp-action="Create">Đăng ký gói</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (Model.Notice is not null) { <div class="alert alert-danger" role="alert">@Model.Notice</div> }

<div class="table-card">
    <table>
        <thead><tr><th>Hội viên</th><th>Gói tập</th><th>Hiệu lực</th><th>Trạng thái gói</th><th>Hóa đơn</th><th>Công nợ</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            var remaining = (item.Total ?? 0) - (item.Paid ?? 0);
            <tr>
                <td><strong>@item.MemberCode</strong><br />@item.MemberName</td>
                <td>@item.PlanName</td>
                <td>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td>
                <td><span class="status-pill @DisplayLabels.StatusCss(item.Status)">@DisplayLabels.Status(item.Status)</span></td>
                <td>
                    @(item.InvoiceCode ?? "—")
                    @if (item.InvoiceStatus is not null)
                    {
                        <br /><span class="muted">@DisplayLabels.Status(item.InvoiceStatus)</span>
                    }
                </td>
                <td><strong>@remaining.ToString("N0") ₫</strong></td>
                <td class="actions">
                    @if (item.InvoiceId is not null && remaining > 0)
                    {
                        <a asp-action="Pay" asp-route-invoiceId="@item.InvoiceId">Thanh toán</a>
                    }
                    @if (item.Status is "ACTIVE" or "PENDING" or "SUSPENDED")
                    {
                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xác nhận hủy gói của hội viên?');">
                            <input type="hidden" name="reason" value="Hủy theo yêu cầu hội viên" />
                            <button class="link-button danger" type="submit">Hủy gói</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Items.Count == 0) { <p class="empty-state">Chưa có đăng ký gói.</p> }
</div>
