@model GymManagement.Web.Models.MemberDetailsViewModel
@{ ViewData["Title"] = "Chi tiết hội viên"; var m=Model.Member; }

<div class="page-heading">
    <div><p class="eyebrow">@m.Code</p><h1>@m.FullName</h1></div>
    <div class="actions"><a class="button button-light" asp-action="Index">Danh sách</a><a class="button" asp-action="Edit" asp-route-id="@m.Id">Cập nhật</a></div>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }

<div class="dashboard-grid">
    <section class="dashboard-card"><h2>Liên hệ</h2><p>@m.Phone</p><p>@(m.Email ?? "Chưa có email")</p><p>@(m.Address ?? "Chưa có địa chỉ")</p></section>
    <section class="dashboard-card"><h2>Hồ sơ</h2><p>Sinh ngày @m.DateOfBirth.ToString("dd/MM/yyyy")</p><p>Giới tính: @(m.Gender ?? "—")</p><p>Trạng thái: @(m.IsActive ? "Hoạt động" : "Đã ngừng")</p></section>
    <section class="dashboard-card"><h2>Thể trạng</h2><p>Chiều cao: @(m.HeightCm?.ToString() ?? "—") cm</p><p>Cân nặng: @(m.WeightKg?.ToString() ?? "—") kg</p><p>Giờ tập: @(m.PreferredWorkoutTime ?? "—")</p></section>
</div>

<div class="page-heading section-heading"><h2>Lịch sử gói tập</h2><a class="button" asp-controller="Memberships" asp-action="Create" asp-route-memberId="@m.Id">Đăng ký gói</a></div>
<div class="table-card"><table><thead><tr><th>Gói</th><th>Bắt đầu</th><th>Kết thúc</th><th>Giá</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var item in Model.Memberships) { <tr><td>@item.PlanName</td><td>@item.StartDate.ToString("dd/MM/yyyy")</td><td>@item.EndDate.ToString("dd/MM/yyyy")</td><td>@item.Price.ToString("N0") ₫</td><td><span class="status-pill @DisplayLabels.StatusCss(item.Status)">@DisplayLabels.Status(item.Status)</span></td></tr> }
</tbody></table>@if(Model.Memberships.Count==0){<p class="empty-state">Chưa có gói tập.</p>}</div>
