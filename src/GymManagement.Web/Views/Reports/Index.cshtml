@model ReportViewModel
@using GymManagement.Web.Authorization
@{ ViewData["Title"] = "Báo cáo"; var finance = User.IsInRole(RoleCodes.Admin) || User.IsInRole(RoleCodes.Accountant); var members = User.IsInRole(RoleCodes.Admin) || User.IsInRole(RoleCodes.Receptionist); var operations = User.IsInRole(RoleCodes.Admin) || User.IsInRole(RoleCodes.Receptionist) || User.IsInRole(RoleCodes.Trainer); }
<section class="page-heading"><div><p class="eyebrow">PHÂN TÍCH VẬN HÀNH</p><h1>Báo cáo<span class="accent">.</span></h1><p class="muted">Tổng hợp dữ liệu thực theo phân quyền tài khoản.</p></div><button type="button" class="button button-secondary" onclick="window.print()">In báo cáo</button></section>
<nav class="report-tabs" aria-label="Chọn báo cáo">
    @if (finance) { <a class="@(Model.Type == "revenue" ? "selected" : "")" asp-action="Index" asp-route-type="revenue">Doanh thu</a> }
    @if (members) { <a class="@(Model.Type == "members" ? "selected" : "")" asp-action="Index" asp-route-type="members">Sắp hết hạn</a> }
    @if (operations) { <a class="@(Model.Type == "classes" ? "selected" : "")" asp-action="Index" asp-route-type="classes">Công suất lớp</a><a class="@(Model.Type == "attendance" ? "selected" : "")" asp-action="Index" asp-route-type="attendance">Điểm danh</a> }
</nav>
@if (Model.Type != "members") { <form method="get" class="filter-panel report-filter"><input type="hidden" name="type" value="@Model.Type" /><label for="from">Từ ngày</label><input id="from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" required /><label for="to">Đến ngày</label><input id="to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" required /><button type="submit" class="button">Lọc báo cáo</button></form> }
@if (ViewData["Error"] is string error) { <div class="alert alert-warning" role="status">@error</div> }
<section class="panel table-panel">
    <div class="panel-heading"><div><h2>@(Model.Type switch { "members" => "Hội viên sắp hết hạn", "classes" => "Công suất lớp theo buổi", "attendance" => "Lịch sử điểm danh", _ => "Doanh thu theo ngày" })</h2><p>@(Model.Type == "members" ? "Từ view membership của module TV2" : $"{Model.From:dd/MM/yyyy} – {Model.To:dd/MM/yyyy}")</p></div></div>
    <div class="table-scroll">
    @if (Model.Type == "members") { <table><thead><tr><th>HỘI VIÊN</th><th>ĐIỆN THOẠI</th><th>GÓI TẬP</th><th>HẾT HẠN</th><th>CÒN LẠI</th></tr></thead><tbody>@foreach (var item in Model.Expiring) { <tr><td><b>@item.Name</b></td><td>@item.Phone</td><td>@item.PlanName</td><td>@item.EndDate.ToString("dd/MM/yyyy")</td><td><span class="status-pill status-open">@item.DaysRemaining ngày</span></td></tr> }</tbody></table>@if (Model.Expiring.Count == 0) { <div class="empty-state">Không có hội viên sắp hết hạn trong 30 ngày tới.</div> } }
    else if (Model.Type == "classes") { <table><thead><tr><th>LỚP</th><th>PHÒNG</th><th>HUẤN LUYỆN VIÊN</th><th>BẮT ĐẦU</th><th>ĐÃ ĐẶT</th><th>SỨC CHỨA</th><th>CÒN CHỖ</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach (var item in Model.Classes) { <tr><td><b>@item.ClassName</b></td><td>@item.RoomName</td><td>@item.TrainerName</td><td>@item.StartAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Booked</td><td>@item.Capacity</td><td>@item.Available</td><td>@item.Status</td></tr> }</tbody></table>@if (Model.Classes.Count == 0) { <div class="empty-state">Không có buổi tập trong khoảng đã chọn.</div> } }
    else if (Model.Type == "attendance") { <table><thead><tr><th>HỘI VIÊN</th><th>MÃ</th><th>THỜI GIAN</th><th>LỚP</th><th>NHÂN VIÊN</th><th>PHƯƠNG THỨC</th></tr></thead><tbody>@foreach (var item in Model.Attendance) { <tr><td><b>@item.MemberName</b></td><td>@item.MemberCode</td><td>@item.CheckedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.ClassName ?? "Tập tự do")</td><td>@item.EmployeeName</td><td>@item.Method</td></tr> }</tbody></table>@if (Model.Attendance.Count == 0) { <div class="empty-state">Không có lượt check-in trong khoảng đã chọn.</div> } }
    else { <table><thead><tr><th>NGÀY</th><th>SỐ GIAO DỊCH</th><th class="align-right">DOANH THU</th></tr></thead><tbody>@foreach (var item in Model.Revenue) { <tr><td>@item.Date.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</td><td>@item.PaymentCount</td><td class="align-right"><b>@item.Revenue.ToString("N0") ₫</b></td></tr> }</tbody><tfoot><tr><td colspan="2">TỔNG CỘNG</td><td class="align-right">@Model.Revenue.Sum(r => r.Revenue).ToString("N0") ₫</td></tr></tfoot></table>@if (Model.Revenue.Count == 0) { <div class="empty-state">Không có doanh thu trong khoảng đã chọn.</div> } }
    </div>
</section>
