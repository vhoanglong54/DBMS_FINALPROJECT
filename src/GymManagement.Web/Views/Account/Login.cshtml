@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-card" aria-labelledby="login-title">
    <div>
        <p class="eyebrow">DBMS330284</p>
        <h1 id="login-title">Đăng nhập hệ thống</h1>
        <p class="muted">Sử dụng tài khoản được quản trị viên cấp. Tài khoản sẽ khóa 15 phút sau 5 lần nhập sai.</p>
    </div>

    <form asp-action="Login" method="post" novalidate>
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" autofocus />
        <span asp-validation-for="Username" class="field-validation"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-validation"></span>

        <label class="checkbox-row">
            <input asp-for="RememberMe" />
            <span>Ghi nhớ đăng nhập trên thiết bị này</span>
        </label>

        <button class="button" type="submit">Đăng nhập</button>
    </form>
</section>
