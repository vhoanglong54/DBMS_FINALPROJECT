@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-shell" aria-labelledby="login-title">
    <aside class="auth-visual" aria-label="Giới thiệu hệ thống">
        <div>
            <p class="eyebrow">Gym operations platform</p>
            <h1>Điều hành phòng tập<br /><span class="accent">gọn trong một nơi.</span></h1>
            <p>Theo dõi hội viên, lớp học, check-in và doanh thu bằng dữ liệu trực tiếp từ SQL Server.</p>
        </div>
        <ul class="auth-features">
            <li><span aria-hidden="true">01</span> Quản lý hội viên và vòng đời gói tập</li>
            <li><span aria-hidden="true">02</span> Đặt lớp, hàng chờ và điểm danh tập luyện</li>
            <li><span aria-hidden="true">03</span> Báo cáo vận hành theo đúng vai trò</li>
        </ul>
    </aside>

    <div class="auth-card">
        <div class="auth-card-heading">
            <span class="auth-icon" aria-hidden="true">G</span>
            <div>
                <p class="eyebrow">Khu vực nhân viên</p>
                <h2 id="login-title">Chào mừng trở lại</h2>
            </div>
        </div>
        <p class="muted">Đăng nhập bằng tài khoản do quản trị viên cấp để bắt đầu ca làm việc.</p>

        @if (TempData["LoginNotice"] is string notice)
        {
            <div class="alert alert-warning" role="alert">@notice</div>
        }

        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="field-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" autofocus placeholder="Nhập tên đăng nhập" />
                <span asp-validation-for="Username" class="field-validation"></span>
            </div>

            <div class="field-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <label class="checkbox-row">
                <input asp-for="RememberMe" />
                <span>Ghi nhớ đăng nhập trên thiết bị này</span>
            </label>

            <button class="button button-block" type="submit">Đăng nhập an toàn <span aria-hidden="true">→</span></button>
        </form>
        <p class="security-note"><span aria-hidden="true">●</span> Tài khoản tự khóa 15 phút sau 5 lần nhập sai.</p>
    </div>
</section>
