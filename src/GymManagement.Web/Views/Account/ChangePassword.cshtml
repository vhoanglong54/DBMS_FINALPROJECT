@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    var mustChangePassword = string.Equals(
        User.FindFirst("must_change_password")?.Value,
        bool.TrueString,
        StringComparison.OrdinalIgnoreCase);
}

<section class="auth-shell" aria-labelledby="change-password-title">
    <aside class="auth-visual" aria-label="Bảo vệ tài khoản">
        <div>
            <p class="eyebrow">Bảo mật tài khoản</p>
            <h1>Mật khẩu mới.<br /><span class="accent">Ca làm việc an tâm.</span></h1>
            <p>Mật khẩu mới được băm với salt riêng trước khi lưu vào SQL Server. Không chia sẻ mật khẩu của bạn với người khác.</p>
        </div>
    </aside>

    <div class="auth-card">
        <div class="auth-card-heading">
            <span class="auth-icon" aria-hidden="true">G</span>
            <div>
                <p class="eyebrow">Tài khoản nhân viên</p>
                <h2 id="change-password-title">Đổi mật khẩu</h2>
            </div>
        </div>

        @if (mustChangePassword)
        {
            <div class="alert alert-warning" role="alert">
                Đây là mật khẩu tạm thời. Bạn cần đổi mật khẩu trước khi sử dụng các chức năng khác.
            </div>
        }
        else
        {
            <p class="muted">Nhập mật khẩu hiện tại để xác nhận bạn là chủ tài khoản.</p>
        }

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="field-group">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" autocomplete="current-password" autofocus />
                <span asp-validation-for="CurrentPassword" class="field-validation"></span>
            </div>

            <div class="field-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation"></span>
            </div>

            <div class="field-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
            </div>

            <button class="button button-block" type="submit">Lưu mật khẩu mới <span aria-hidden="true">→</span></button>
        </form>
        <p class="security-note">Mật khẩu mới phải có từ 8 đến 128 ký tự và khác mật khẩu hiện tại.</p>
    </div>
</section>
