@model GymManagement.Web.Models.SessionDetailsViewModel
@{ViewData["Title"]="Quản lý buổi lớp";var s=Model.Session;}
<div class="page-heading"><div><p class="eyebrow">@s.StartAt.ToString("dd/MM/yyyy HH:mm")</p><h1>@s.ClassName</h1><p>@s.RoomName · @s.TrainerName · @s.Booked/@s.Capacity chỗ</p></div><a class="button button-light" asp-action="Index">Quay lại</a></div>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string er){<div class="alert alert-danger">@er</div>}
<div class="split-grid"><form asp-action="Book" method="post" class="form-card narrow"><input type="hidden" name="sessionId" value="@s.Id"/><h2>Đặt chỗ</h2><label>Mã số hội viên</label><input type="number" name="memberId" min="1" required/><button class="button">Đặt chỗ</button><a asp-controller="MemberSearch" asp-action="Index">Tra cứu hội viên</a></form><form asp-action="CancelSession" method="post" class="form-card narrow"><input type="hidden" name="id" value="@s.Id"/><h2>Hủy buổi lớp</h2><label>Lý do</label><input name="reason" required/><button class="button button-danger">Hủy buổi lớp</button></form></div>
<div class="page-heading section-heading"><h2>Danh sách đặt chỗ</h2></div><div class="table-card"><table><thead><tr><th>Hội viên</th><th>Đặt lúc</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model.Bookings){<tr><td>@x.MemberCode — @x.MemberName</td><td>@x.BookedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td>@x.Status</td><td>@if(x.Status is "CONFIRMED" or "WAITLISTED"){<form asp-action="CancelBooking" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="sessionId" value="@s.Id"/><input type="hidden" name="reason" value="Hủy bởi nhân viên"/><button class="link-button danger">Hủy chỗ</button></form>}</td></tr>}</tbody></table></div>
