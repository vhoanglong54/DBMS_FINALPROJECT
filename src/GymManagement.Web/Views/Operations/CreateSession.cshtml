@model GymManagement.Web.Models.SessionCreateViewModel
@{ViewData["Title"]="Tạo buổi lớp";}
<div class="page-heading"><h1>Tạo buổi lớp</h1></div><form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div><label asp-for="ClassId"></label><select asp-for="ClassId"><option value="0">-- Chọn --</option>@foreach(var x in Model.Classes){<option value="@x.Id">@x.Name</option>}</select></div><div><label asp-for="RoomId"></label><select asp-for="RoomId"><option value="0">-- Chọn --</option>@foreach(var x in Model.Rooms){<option value="@x.Id">@x.Name (@x.Capacity)</option>}</select></div><div><label asp-for="TrainerId"></label><select asp-for="TrainerId"><option value="0">-- Chọn --</option>@foreach(var x in Model.Trainers){<option value="@x.Id">@x.Name</option>}</select></div><div><label asp-for="Capacity"></label><input asp-for="Capacity" type="number" placeholder="Mặc định theo phòng"/></div><div><label asp-for="StartAt"></label><input asp-for="StartAt" type="datetime-local"/></div><div><label asp-for="EndAt"></label><input asp-for="EndAt" type="datetime-local"/></div><div class="span-2"><label asp-for="Note"></label><textarea asp-for="Note"></textarea></div></div><div class="form-actions"><button class="button">Tạo lịch</button><a class="button button-light" asp-action="Index">Hủy</a></div></form>
