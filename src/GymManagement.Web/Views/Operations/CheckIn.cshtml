@model GymManagement.Web.Models.CheckInViewModel
@{ ViewData["Title"] = "Check-in"; }

<div class="page-heading">
    <div>
        <p class="eyebrow">Vận hành tại quầy</p>
        <h1>Check-in hội viên</h1>
        <p class="muted">Nhập mã hiển thị trên hồ sơ hội viên, ví dụ HV0001.</p>
    </div>
    @if (!Model.IsTrainer)
    {
        <a class="button button-light" asp-controller="MemberSearch" asp-action="Index">Tra cứu hội viên</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (Model.IsTrainer && Model.AvailableSessions.Count == 0)
{
    <p class="alert alert-danger">Hiện không có buổi lớp của bạn trong giờ check-in.</p>
}
<form method="post" class="form-card">
    <input asp-for="Method" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <div class="form-grid">
        <div>
            <label asp-for="MemberCode"></label>
            <input asp-for="MemberCode" maxlength="20" autocomplete="off" placeholder="HV0001" />
            <span asp-validation-for="MemberCode" class="field-validation"></span>
        </div>
        <div>
            <label asp-for="SessionId"></label>
            <select asp-for="SessionId" required="@(Model.IsTrainer ? "required" : null)">
                @if (!Model.IsTrainer) { <option value="">Tập tự do</option> }
                @foreach (var session in Model.AvailableSessions)
                {
                    <option value="@session.Id">@session.ClassName — @session.StartAt.ToString("HH:mm") — @session.TrainerName</option>
                }
            </select>
            <span asp-validation-for="SessionId" class="field-validation"></span>
        </div>
    </div>
    <div class="form-actions">
        <button class="button" type="submit">Ghi nhận check-in</button>
        <a class="button button-light" asp-action="Index">Quay lại vận hành</a>
    </div>
</form>

<div class="page-heading section-heading">
    <h2>Lịch sử check-in gần nhất</h2>
</div>
<div class="table-card">
    <table>
        <thead><tr><th>Thời gian</th><th>Hội viên</th><th>Hình thức tập</th><th>Nhân viên</th><th>Phương thức</th></tr></thead>
        <tbody>
        @foreach (var item in Model.History)
        {
            <tr>
                <td>@item.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td><strong>@item.MemberCode</strong><br />@item.MemberName</td>
                <td>@(item.ClassName ?? "Tập tự do")</td>
                <td>@item.EmployeeName</td>
                <td><span class="badge">@DisplayLabels.CheckInMethod(item.Method)</span></td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.History.Count == 0)
    {
        <p class="empty-state">Chưa có lượt check-in phù hợp.</p>
    }
</div>
