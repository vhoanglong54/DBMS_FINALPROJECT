@model GymManagement.Web.Models.CheckInViewModel
@{ViewData["Title"]="Check-in";}
<div class="page-heading"><div><p class="eyebrow">Vận hành</p><h1>Check-in hội viên</h1></div></div>@if(TempData["Success"] is string s){<div class="alert alert-success">@s</div>}
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div><label>Mã số hội viên</label><input asp-for="MemberId" type="number" min="1"/></div><div><label>Session ID (nếu check-in lớp)</label><input asp-for="SessionId" type="number"/></div><div><label>Phương thức</label><select asp-for="Method"><option value="FRONT_DESK">Lễ tân</option><option value="BARCODE">Mã vạch</option><option value="KIOSK">Kiosk</option></select></div></div><button class="button">Ghi nhận check-in</button></form>
<div class="page-heading section-heading"><h2>Lịch sử gần nhất</h2></div><div class="table-card"><table><thead><tr><th>Thời gian</th><th>Hội viên</th><th>Lớp</th><th>Nhân viên</th><th>Cách thức</th></tr></thead><tbody>@foreach(var x in Model.History){<tr><td>@x.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@x.MemberCode — @x.MemberName</td><td>@(x.ClassName??"Tập tự do")</td><td>@x.EmployeeName</td><td>@x.Method</td></tr>}</tbody></table></div>
