@model GymManagement.Web.Models.ClassTypeEditViewModel
@{ViewData["Title"]=Model.Id is null?"Thêm loại lớp":"Cập nhật loại lớp";}
<div class="page-heading"><h1>@ViewData["Title"]</h1></div><form method="post" class="form-card narrow"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Code"></label><input asp-for="Code"/><label asp-for="Name"></label><input asp-for="Name"/><label asp-for="Description"></label><textarea asp-for="Description"></textarea><label asp-for="Duration"></label><input asp-for="Duration" type="number"/><label asp-for="Difficulty"></label><select asp-for="Difficulty"><option value="BEGINNER">Cơ bản</option><option value="INTERMEDIATE">Trung bình</option><option value="ADVANCED">Nâng cao</option><option value="ALL_LEVELS">Mọi trình độ</option></select><div class="form-actions"><button class="button">Lưu</button><a class="button button-light" asp-action="Index">Hủy</a></div></form>
