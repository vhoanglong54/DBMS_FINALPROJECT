@model StaffAccountCreateViewModel
@{
    ViewData["Title"] = "Thêm nhân viên";
}

<div class="page-heading">
    <div><p class="eyebrow">Nhân sự</p><h1>Thêm nhân viên</h1></div>
</div>

<form asp-action="Create" method="post" class="form-card narrow">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

    <h2>Thông tin nhân viên</h2>
    <div class="form-grid">
        <div><label asp-for="EmployeeCode"></label><input asp-for="EmployeeCode" autocomplete="off" /><span asp-validation-for="EmployeeCode" class="field-validation"></span></div>
        <div><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="field-validation"></span></div>
        <div><label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" /><span asp-validation-for="Phone" class="field-validation"></span></div>
        <div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="field-validation"></span></div>
        <div><label asp-for="HireDate"></label><input asp-for="HireDate" type="date" /><span asp-validation-for="HireDate" class="field-validation"></span></div>
        <div><label asp-for="EmployeeType"></label><select asp-for="EmployeeType"><option value="RECEPTIONIST">Lễ tân</option><option value="TRAINER">Huấn luyện viên</option><option value="ACCOUNTANT">Kế toán</option><option value="MANAGER">Quản lý</option></select><span asp-validation-for="EmployeeType" class="field-validation"></span></div>
    </div>

    <h2 class="staff-form-section">Tài khoản đăng nhập</h2>
    <div class="form-grid">
        <div class="span-2"><label asp-for="Username"></label><input asp-for="Username" autocomplete="off" autocapitalize="none" spellcheck="false" /><span asp-validation-for="Username" class="field-validation"></span></div>
        <div><label asp-for="InitialPassword"></label><input asp-for="InitialPassword" autocomplete="new-password" /><span asp-validation-for="InitialPassword" class="field-validation"></span></div>
        <div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div>
    </div>

    <div class="form-actions">
        <button class="button" type="submit">Cấp tài khoản</button>
        <a class="button button-light" asp-action="Index">Hủy</a>
    </div>
</form>
