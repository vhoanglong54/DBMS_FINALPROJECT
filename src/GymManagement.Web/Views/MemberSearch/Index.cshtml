@model MemberSearchViewModel
@using System.Globalization
@{ ViewData["Title"] = "Tra cứu hội viên"; var pageCount = Model.PageCount; }
<section class="page-heading"><div><p class="eyebrow">HỒ SƠ KHÁCH HÀNG</p><h1>Tra cứu hội viên<span class="accent">.</span></h1><p class="muted">Tìm theo tên, mã hội viên hoặc số điện thoại; kết quả có phân trang.</p></div></section>
@if (Model.Notice is not null) { <div class="alert alert-warning" role="status">@Model.Notice</div> }
<form method="get" class="filter-panel">
    <label for="q">Từ khóa</label><input id="q" name="q" maxlength="120" value="@Model.Query" placeholder="Tên, mã hội viên, số điện thoại" />
    <label for="status">Trạng thái gói</label><select id="status" name="status"><option value="">Tất cả</option>@foreach (var value in new[] { "ACTIVE", "UPCOMING", "EXPIRED", "PENDING", "CANCELLED", "NO_MEMBERSHIP", "INACTIVE" }) { <option value="@value" selected="@(Model.Status == value)">@DisplayLabels.Status(value)</option> }</select>
    <label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize">@foreach (var size in new[] { 10, 20, 50, 100 }) { <option value="@size" selected="@(Model.PageSize == size)">@size</option> }</select><button type="submit" class="button">Tìm kiếm</button>
</form>
<section class="panel table-panel">
    <div class="panel-heading"><div><h2>Kết quả</h2><p>@Model.TotalCount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) hội viên · trang @Model.Page / @pageCount</p></div></div>
    <div class="table-scroll"><table><thead><tr><th>HỘI VIÊN</th><th>MÃ HỘI VIÊN</th><th>ĐIỆN THOẠI</th><th>EMAIL</th><th>TRẠNG THÁI GÓI</th><th>NGÀY HẾT HẠN</th></tr></thead><tbody>
    @foreach (var member in Model.Members) { <tr><td><b>@member.Name</b></td><td><span class="code-text">@member.MemberCode</span></td><td>@member.Phone</td><td>@(member.Email ?? "—")</td><td><span class="status-pill @DisplayLabels.StatusCss(member.Status)">@DisplayLabels.Status(member.Status)</span></td><td>@(member.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr> }
    @if (Model.Members.Count == 0) { <tr><td colspan="6"><div class="empty-state">@(Model.TotalCount == 0 ? "Không tìm thấy hồ sơ phù hợp." : "Không có kết quả ở trang này.")</div></td></tr> }
    </tbody></table></div>
    <nav class="pagination" aria-label="Phân trang">
        @if (Model.Page > 1) { <a asp-action="Index" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">← Trước</a> } else { <span class="disabled">← Trước</span> }
        <span>Trang @Model.Page trên @pageCount</span>
        @if (Model.Page < pageCount) { <a asp-action="Index" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Tiếp →</a> } else { <span class="disabled">Tiếp →</span> }
    </nav>
</section>
